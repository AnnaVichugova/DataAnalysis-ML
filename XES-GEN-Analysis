def _fmt_dt(dt):
    return dt.strftime('%Y-%m-%dT%H:%M:%S')


def _add_event(parts, activity, resource, role, system,
               ts_start, ts_end, extra_attrs=None):
    parts.append('\t\t<event>')
    parts.append(f'\t\t\t<string key="concept:name" value="{escape(str(activity))}" />')
    parts.append(f'\t\t\t<string key="org:resource" value="{escape(str(resource))}" />')
    parts.append(f'\t\t\t<string key="concept:role" value="{escape(str(role))}" />')
    parts.append(f'\t\t\t<string key="concept:system" value="{escape(str(system))}" />')
    parts.append(f'\t\t\t<string key="lifecycle:transition" value="complete" />')
    parts.append(f'\t\t\t<date key="time:timestamp" value="{_fmt_dt(ts_start)}" />')
    parts.append(f'\t\t\t<date key="timestamp:start" value="{_fmt_dt(ts_start)}" />')
    parts.append(f'\t\t\t<date key="timestamp:end" value="{_fmt_dt(ts_end)}" />')
    if extra_attrs:
        for k, v in extra_attrs.items():
            if v is None or (isinstance(v, float) and np.isnan(v)):
                continue
            if isinstance(v, (int, np.integer)):
                parts.append(f'\t\t\t<int key="custom:{k}" value="{int(v)}" />')
            elif isinstance(v, (float, np.floating)):
                parts.append(f'\t\t\t<float key="custom:{k}" value="{v:.2f}" />')
            else:
                parts.append(f'\t\t\t<string key="custom:{k}" value="{escape(str(v))}" />')
    parts.append('\t\t</event>')


def _wrap_with_boundaries(cfg, kind='order'):
    """Оборачивает activities start/end-событиями (имена из CONFIG)."""
    if kind == 'batch':
        acts = cfg['batch_activities']
        start = (cfg['batch_start_event_name'], cfg['batch_start_system'], 'System', 0)
        end   = (cfg['batch_end_event_name'],   cfg['batch_end_system'],   'System', 0)
    else:
        acts = cfg['order_activities']
        start = (cfg['start_event_name'], cfg['start_system'], 'System', 0)
        end   = (cfg['end_event_name'],   cfg['end_system'],   'System', 0)
    return [start] + list(acts) + [end]


def _prev_minutes(activities, idx):
    if idx <= 0:
        return 0
    return activities[idx - 1][3]


def _simulate_activities(parts, activities, base_dt, resources_pool,
                          p_rework=0.15, p_skip=0.05, p_loopback=0.10,
                          extra_trace_attrs=None):
    current_dt = base_dt
    for idx, (activity, system, role, base_minutes) in enumerate(activities):
        if random.random() < p_skip and 0 < idx < len(activities) - 1 and base_minutes > 0:
            continue

        if base_minutes == 0:
            resource = 'system'
            duration = 0
        else:
            resource = random.choice(resources_pool[role])
            duration = base_minutes * random.uniform(0.6, 1.8)

        ts_start = current_dt
        ts_end = ts_start + timedelta(minutes=duration)

        _add_event(parts, activity, resource, role, system,
                   ts_start, ts_end, extra_attrs=extra_trace_attrs)

        current_dt = ts_end + timedelta(minutes=random.uniform(2, 30))

        if base_minutes > 0 and ('ОТК' in activity or 'QA' in activity or 'качеств' in activity.lower()):
            if random.random() < p_rework:
                resource2 = random.choice(resources_pool[role])
                ts_s = current_dt
                ts_e = ts_s + timedelta(minutes=duration * 0.7)
                _add_event(parts, activity + ' (повторно)',
                           resource2, role, system, ts_s, ts_e,
                           extra_attrs={'rework': 1})
                current_dt = ts_e + timedelta(minutes=random.uniform(2, 15))

        if (random.random() < p_loopback
                and idx > 0
                and base_minutes > 0
                and _prev_minutes(activities, idx) > 0):
            prev_act, prev_sys, prev_role, _ = activities[idx - 1]
            resource3 = random.choice(resources_pool[prev_role])
            ts_s = current_dt
            ts_e = ts_s + timedelta(minutes=base_minutes * 0.4)
            _add_event(parts, prev_act + ' (доработка)',
                       resource3, prev_role, prev_sys, ts_s, ts_e,
                       extra_attrs={'loopback': 1})
            current_dt = ts_e + timedelta(minutes=random.uniform(2, 10))


def generate_xes(case_key, output_path=None):
    cfg = XES_CONFIG[case_key]
    output_path = output_path or f'{case_key}_log.xes'

    facts    = pd.read_csv(cfg['facts'], parse_dates=[cfg['date_col']])
    entities = pd.read_csv(cfg['entities'])
    ref      = pd.read_csv(cfg['ref'])

    ref_cols = [cfg['ref_col']] + [c for c in cfg['extra_attrs'] if c in ref.columns]
    if cfg.get('cost_col') and cfg['cost_col'] in ref.columns:
        ref_cols.append(cfg['cost_col'])
    df = facts.merge(ref[list(dict.fromkeys(ref_cols))], on=cfg['ref_col'], how='left')

    ent_cols = [cfg['entity_col']] + [c for c in cfg['extra_attrs'] if c in entities.columns]
    df = df.merge(entities[list(dict.fromkeys(ent_cols))], on=cfg['entity_col'], how='left')

    df['_amount'] = cfg['amount_fn'](df)

    # Пул ресурсов: batch + order + System
    all_activities = list(cfg['batch_activities']) + list(cfg['order_activities'])
    roles = sorted({a[2] for a in all_activities} | {'System'})
    resources_pool = {role: [f'{role.lower().replace(" ", "-")}-{i:02d}'
                             for i in range(1, 6)] for role in roles}

    parts = [
        '<?xml version="1.0" encoding="utf-8" ?>',
        '<log xes.version="1849-2016" xes.features="nested-attributes" xmlns="http://www.xes-standard.org/">',
    ]

    # ---- batch-трейсы (для всех кейсов, multi_trace=True) ----
    batch_map = {}
    unique_refs = df[cfg['ref_col']].dropna().unique()
    for ref_id in unique_refs:
        first_sale = df[df[cfg['ref_col']] == ref_id][cfg['date_col']].min()
        batch_start = first_sale - pd.Timedelta(days=int(random.uniform(60, 120)))
        batch_id = f'BATCH-{ref_id}'
        batch_map[ref_id] = (batch_id, batch_start.to_pydatetime())

    batch_acts = _wrap_with_boundaries(cfg, kind='batch')
    ref_info = ref.set_index(cfg['ref_col']).to_dict('index')

    for ref_id, (batch_id, batch_start) in batch_map.items():
        parts.append('\t<trace>')
        parts.append(f'\t\t<string key="concept:name" value="{escape(batch_id)}" />')
        parts.append(f'\t\t<string key="concept:instance" value="{escape(batch_id)}" />')
        parts.append('\t\t<string key="custom:trace_type" value="batch" />')
        parts.append(f'\t\t<string key="custom:ref_id" value="{escape(str(ref_id))}" />')
        if ref_id in ref_info:
            ri = ref_info[ref_id]
            # Пытаемся вытащить «человеческое» имя продукта/услуги/игры
            for name_key in ['product_name', 'service_name', 'game_name', 'name']:
                if name_key in ri and pd.notna(ri[name_key]):
                    parts.append(f'\t\t<string key="custom:ref_name" value="{escape(str(ri[name_key]))}" />')
                    break
            for cat_key in ['category', 'practice', 'genre']:
                if cat_key in ri and pd.notna(ri[cat_key]):
                    parts.append(f'\t\t<string key="custom:category" value="{escape(str(ri[cat_key]))}" />')
                    break

        _simulate_activities(parts, batch_acts, batch_start, resources_pool,
                             p_rework=0.20, p_skip=0.02, p_loopback=0.05)
        parts.append('\t</trace>')

    # ---- order-трейсы (для всех кейсов) ----
    order_acts = _wrap_with_boundaries(cfg, kind='order')

    for _, row in df.iterrows():
        trace_id = str(row[cfg['trace_id_col']])
        parts.append('\t<trace>')
        parts.append(f'\t\t<string key="concept:name" value="{escape(trace_id)}" />')
        parts.append(f'\t\t<string key="concept:instance" value="{escape(trace_id)}" />')
        parts.append('\t\t<string key="custom:trace_type" value="order" />')
        parts.append(f'\t\t<string key="org:entity" value="{escape(str(row.get(cfg["entity_col"], "")))}" />')
        parts.append(f'\t\t<float key="custom:amount" value="{float(row["_amount"]):.2f}" />')

        # Ссылка на производственную партию
        if row[cfg['ref_col']] in batch_map:
            parts.append(f'\t\t<string key="custom:batch_id" value="{escape(batch_map[row[cfg["ref_col"]]][0])}" />')

        # Канал
        if 'sale_channel' in row and row['sale_channel'] in cfg['channels']:
            label, ch_id = cfg['channels'][row['sale_channel']]
            parts.append(f'\t\t<string key="custom:channel" value="{escape(label)}" />')
            parts.append(f'\t\t<string key="custom:channel_id" value="{ch_id}" />')
        elif 'revenue_type' in row and row['revenue_type'] in cfg['channels']:
            label, ch_id = cfg['channels'][row['revenue_type']]
            parts.append(f'\t\t<string key="custom:channel" value="{escape(label)}" />')
            parts.append(f'\t\t<string key="custom:channel_id" value="{ch_id}" />')

        for attr in cfg['extra_attrs']:
            if attr in row and pd.notna(row[attr]):
                parts.append(f'\t\t<string key="custom:{attr}" value="{escape(str(row[attr]))}" />')

        for flag_name in ['return_flag', 'scope_flag', 'qa_flag']:
            if flag_name in cfg and cfg[flag_name] in row:
                val = row[cfg[flag_name]]
                if pd.notna(val):
                    parts.append(f'\t\t<int key="custom:{cfg[flag_name]}" value="{int(val)}" />')

        base_dt = pd.to_datetime(row[cfg['date_col']]).to_pydatetime()
        p_skip = 0.05
        if 'sale_channel' in row and row['sale_channel'] == 'B2B Wholesalers':
            p_skip = 0.25

        _simulate_activities(parts, order_acts, base_dt, resources_pool,
                             p_rework=0.15, p_skip=p_skip, p_loopback=0.10)

        parts.append('\t</trace>')

    parts.append('</log>')

    with open(output_path, 'w', encoding='utf-8') as f:
        f.write('\n'.join(parts))

    n_traces = sum(1 for line in parts if '<trace>' in line)
    n_events = sum(1 for line in parts if '<event>' in line)
    size_kb = os.path.getsize(output_path) / 1024

