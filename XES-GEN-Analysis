def plot_case_duration(log, title, subtitle):
    """Распределение длительности кейсов (в часах)."""
    durations = []
    for trace in log:
        events = sorted(trace, key=lambda e: e['time:timestamp'])
        if len(events) >= 2:
            dur = (events[-1]['time:timestamp']
                   - events[0]['time:timestamp']).total_seconds() / 3600
            durations.append(dur)

    if not durations:
        print("Нет трейсов с 2+ событиями")
        return

    fig, ax = plt.subplots(figsize=(10, 4))
    ax.hist(durations, bins=40, color='coral', edgecolor='black', alpha=0.8)
    ax.set_xlabel('Длительность кейса, часы')
    ax.set_ylabel('Число кейсов')
    ax.set_title(f'{title}\n{subtitle}', fontsize=11, loc='left')
    ax.grid(alpha=0.3, axis='y')

