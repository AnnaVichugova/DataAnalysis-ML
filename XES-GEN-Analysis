# ---------- 1. Считаем времена ожидания ----------
wait_times = defaultdict(list)

for trace in log:
    events = sorted(trace, key=lambda e: e['time:timestamp'])
    for i in range(len(events) - 1):
        cur = events[i]
        nxt = events[i + 1]
        # Окончание текущего события; если нет — берём его старт
        cur_end = cur.get('timestamp:end', cur['time:timestamp'])
        # Ожидание = старт следующего минус окончание текущего
        wait = (nxt['time:timestamp'] - cur_end).total_seconds() / 60
        if wait < 0:
            wait = 0  # защита от артефактов синхронизации
        pair = (cur['concept:name'], nxt['concept:name'])
        wait_times[pair].append(wait)


# ---------- 2. Сводная таблица ----------
bottlenecks = []
for pair, waits in wait_times.items():
    if len(waits) < 2:
        continue  # пары с 1 наблюдением статистически бесполезны
    bottlenecks.append({
        'from':            pair[0],
        'to':              pair[1],
        'mean_wait_min':   round(float(np.mean(waits)), 1),
        'median_wait_min': round(float(np.median(waits)), 1),
        'p95_wait_min':    round(float(np.percentile(waits, 95)), 1),
        'n':               len(waits),
    })

bottleneck_df = (pd.DataFrame(bottlenecks)
                 .sort_values('mean_wait_min', ascending=False)
                 .reset_index(drop=True))


