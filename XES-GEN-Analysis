def plot_events_per_time(log, title, subtitle):
    """Плотность событий во времени: ось X — время, ось Y — число событий."""
    # Считаем, сколько событий в каждый день
    from collections import Counter
    dates = []
    for trace in log:
        for event in trace:
            ts = event.get('time:timestamp')
            if ts:
                dates.append(ts.date())

    counts = Counter(dates)
    dates_sorted = sorted(counts)
    values = [counts[d] for d in dates_sorted]

    fig, ax = plt.subplots(figsize=(12, 4))
    ax.plot(dates_sorted, values, marker='o', linewidth=1, markersize=3)
    ax.set_xlabel('Дата')
    ax.set_ylabel('Число событий в день')
    ax.set_title(f'{title}\n{subtitle}', fontsize=11, loc='left')
    ax.grid(alpha=0.3)

    # Пояснение под графиком
    fig.text(0.01, -0.05,
             'Как читать: пики — дни высокой нагрузки, провалы — простой '
             '(выходные, ночь). Неровный график = неравномерная загрузка.',
             fontsize=9, color='gray')
    plt.tight_layout()
    plt.show()


def plot_events_by_weekday(log, title, subtitle):
    """Распределение событий по дням недели."""
    from collections import Counter
    days = []
    for trace in log:
        for event in trace:
            ts = event.get('time:timestamp')
            if ts:
                days.append(ts.weekday())  # 0=Пн, 6=Вс

    labels_ru = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']
    counts = Counter(days)
    values = [counts.get(i, 0) for i in range(7)]

    fig, ax = plt.subplots(figsize=(8, 4))
    bars = ax.bar(labels_ru, values, color='steelblue', edgecolor='black')
    ax.set_xlabel('День недели')
    ax.set_ylabel('Число событий')
    ax.set_title(f'{title}\n{subtitle}', fontsize=11, loc='left')
    ax.grid(alpha=0.3, axis='y')

    # Подписи значений над столбцами
    for bar, v in zip(bars, values):
        ax.text(bar.get_x() + bar.get_width() / 2, v, str(v),
                ha='center', va='bottom', fontsize=9)

    fig.text(0.01, -0.05,
             'Как читать: высокие будни = B2B-ритм; высокие выходные = работа '
             'без выходных. Резкий понедельник = накопление за выходные.',
             fontsize=9, color='gray')
