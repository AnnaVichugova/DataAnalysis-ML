# --- 1. Форматирование длительности ---
def format_duration(minutes):
    """Переводит минуты в человекочитаемый вид: '2 ч. 15 мин.'"""
    if minutes >= 24 * 60:
        days = minutes // (24 * 60)
        rest = minutes % (24 * 60)
        hours = rest // 60
        mins = rest % 60
        return f"{int(days)} дн. {int(hours)} ч. {int(mins)} мин."
    if minutes >= 60:
        return f"{int(minutes // 60)} ч. {int(minutes % 60)} мин."
    return f"{minutes:.1f} мин"


# --- 2. Считаем длительности и роли по активностям ---
activity_durations = defaultdict(list)
activity_performers = defaultdict(set)

for trace in log:
    for event in trace:
        act = event['concept:name']
        start = event.get('time:timestamp')
        end = event.get('timestamp:end', start)
        if start and end:
            duration = (end - start).total_seconds() / 60
            activity_durations[act].append(duration)
        if 'concept:role' in event:
            activity_performers[act].add(event['concept:role'])

avg_durations = {a: statistics.mean(d) for a, d in activity_durations.items()}


# --- 3. Обогащаем подписи (НЕ трогаем concept:name) ---
# ВАЖНО: concept:name остаётся коротким, иначе conformance в ячейке 7
# не найдёт ни одну активность в эталонной BPMN и покажет fitness = 0.
for trace in log:
    for event in trace:
        act = event['concept:name']
        roles = ', '.join(sorted(activity_performers[act])) or 'Не указан'
        duration = avg_durations.get(act, 0)
        event['custom:label'] = (
            f"Задача: {act}\n\n"
            f"Роль: {roles}\n"
            f"Ср. длительность: {format_duration(duration)}"
