    median = sorted(durations)[len(durations) // 2]
    ax.axvline(median, color='navy', linestyle='--', linewidth=1.5,
               label=f'Медиана: {median:.1f} ч')
    ax.legend()

    fig.text(0.01, -0.05,
             'Как читать: колокол = стабильный процесс; длинный правый хвост = '
             'выбросы (rework, ожидание); две вершины = два сценария.',
