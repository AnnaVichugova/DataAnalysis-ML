# ============================================================
# ЯЧЕЙКА 5: build_rfm — RFM-таблица на уровне клиента
# ============================================================
# R — дней с последней покупки (меньше = лучше)
# F — число уникальных заказов
# M — суммарная выручка
# + Средний чек, маржинальность, разнообразие категорий, заказов/мес

def build_rfm(df, cfg):
    snapshot = df[cfg['date_col']].max() + pd.Timedelta(days=1)

    agg = df.groupby(cfg['entity_col']).agg(
        recency_date = (cfg['date_col'], 'max'),
        first_date   = (cfg['date_col'], 'min'),
        frequency    = (cfg['id_col'], 'nunique'),
        monetary     = ('_amount', 'sum'),
        margin       = ('_margin', 'sum'),
        total_items  = ('_amount', 'count'),
    ).reset_index()

    agg['recency']          = (snapshot - agg['recency_date']).dt.days
    agg['lifetime_days']    = (agg['recency_date'] - agg['first_date']).dt.days
    agg['avg_check']        = agg['monetary'] / agg['frequency'].clip(lower=1)
    agg['margin_pct']       = agg['margin'] / agg['monetary'].replace(0, np.nan)
    agg['orders_per_month'] = agg['frequency'] / (agg['lifetime_days'] / 30 + 1)

    if cfg['extras_ref']:
        cat_col = cfg['extras_ref'][0]
        n_cat = df.groupby(cfg['entity_col'])[cat_col].nunique().rename('n_categories')
        agg = agg.merge(n_cat, on=cfg['entity_col'], how='left')

    ent_cols = [cfg['entity_col']] + cfg['extras_entity']
    agg = agg.merge(df[ent_cols].drop_duplicates(cfg['entity_col']),
                    on=cfg['entity_col'], how='left')

    # RFM-скоринги 1..5 (R инвертирован)
    agg['R_score'] = pd.qcut(agg['recency'], 5,
                             labels=[5, 4, 3, 2, 1], duplicates='drop').astype(int)
    agg['F_score'] = pd.qcut(agg['frequency'].rank(method='first'), 5,
                             labels=[1, 2, 3, 4, 5]).astype(int)
    agg['M_score'] = pd.qcut(agg['monetary'].rank(method='first'), 5,
                             labels=[1, 2, 3, 4, 5]).astype(int)
    agg['RFM_combo'] = (agg['R_score'].astype(str)
                        + agg['F_score'].astype(str)
                        + agg['M_score'].astype(str))

    return agg, snapshot


