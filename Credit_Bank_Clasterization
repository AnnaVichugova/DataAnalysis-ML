# 4. Определение оптимального числа кластеров
# ============================================================================
inertias = []
silhouette_scores = []
calinski_scores = []
davies_scores = []

K_range = range(2, 11)

for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = kmeans.fit_predict(X_scaled_df)

    inertias.append(kmeans.inertia_)
    silhouette_scores.append(silhouette_score(X_scaled_df, labels))
    calinski_scores.append(calinski_harabasz_score(X_scaled_df, labels))
    davies_scores.append(davies_bouldin_score(X_scaled_df, labels))

fig, axes = plt.subplots(2, 2, figsize=(15, 11))
fig.suptitle('Определение оптимального числа кластеров\n'
             'Каждая метрика смотрит на качество разбиения со своей стороны',
             fontsize=16)

# --- 4.1. Метод локтя ---
