from matplotlib.lines import Line2D
from sklearn.ensemble import RandomForestClassifier
from sklearn.inspection import permutation_importance

# Собираем список признаков, которые реально есть в df
available_features = [c for c in features_for_clustering if c in df.columns]

# Добавляем логарифмические признаки, если их ещё нет в df
log_cols = ['annual_revenue_log', 'total_debt_log',
            'requested_loan_log', 'average_check_log']
for col in log_cols:
    if col not in df.columns:
        if col == 'annual_revenue_log':
            df['annual_revenue_log'] = np.log1p(df['annual_revenue'])
        elif col == 'total_debt_log':
            df['total_debt_log'] = np.log1p(df['total_debt'])
        elif col == 'requested_loan_log':
            df['requested_loan_log'] = np.log1p(df['requested_loan'])
        elif col == 'average_check_log':
            df['average_check_log'] = np.log1p(df['average_check'])

for col in log_cols:
    if col in df.columns and col not in available_features:
        available_features.append(col)

X_features = df[available_features].copy()
y_clusters = df['cluster']

# Обучаем случайный лес: он «объясняет», какие признаки лучше всего
# разделяют уже найденные кластеры (это не новая кластеризация,
# а проверка, на чём держится разбиение).
rf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)
rf.fit(X_features, y_clusters)

feature_importance = pd.DataFrame({
    'feature': available_features,
    'importance': rf.feature_importances_,
}).sort_values('importance', ascending=False)

perm_importance = permutation_importance(
