def classify_cluster(cluster_data):
    avg_revenue = cluster_data['annual_revenue'].mean()
    avg_age = cluster_data['business_age_years'].mean()
    avg_credit = cluster_data['credit_score'].mean()
    default_rate = cluster_data['default_history'].mean()
    avg_loan = cluster_data['requested_loan'].mean()

    if avg_revenue > 50_000_000 and avg_credit > 700 and default_rate < 0.05:
        return ('Премьер-клиенты (низкий риск)',
                'Одобрять кредиты до 15 млн руб., сниженная ставка, индивидуальные условия')
    if avg_age < 3 and default_rate > 0.2:
        return ('Стартапы (высокий риск)',
                'Повышенные требования к залогу, ставка выше среднего, тщательный скоринг')
    if avg_loan > 5_000_000 and avg_revenue > 20_000_000:
        return ('Крупные заёмщики',
                'Специальные кредитные программы, гибкие условия, персональный менеджер')
    if avg_age > 10 and default_rate < 0.05:
        return ('Стабильный бизнес',
                'Стандартные условия, возможны повторные кредиты, лояльные условия')
    if default_rate > 0.3:
        return ('Проблемные клиенты',
                'Повышенный контроль, требования к обеспечению, ограничение сумм')
    return ('Средний бизнес',
            'Стандартный скоринг, конкурентные ставки')


