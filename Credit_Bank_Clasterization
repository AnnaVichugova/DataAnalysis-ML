linked = linkage(X_sample, method='ward')

THRESHOLD = 15
fig, ax = plt.subplots(figsize=(15, 7))
dendro = dendrogram(
    linked,
    orientation='top',
    distance_sort='descending',
    show_leaf_counts=False,
    color_threshold=THRESHOLD,
    above_threshold_color='lightgray',
    ax=ax,
    truncate_mode='level',
    p=5,
    no_labels=True,
)

# Считаем X-центр для каждого цветового блока и подписываем кластеры
blocks = defaultdict(list)
for icoord, color in zip(dendro['icoord'], dendro['color_list']):
    blocks[color].append(float(np.mean(icoord)))

ordered_blocks = sorted(
    [(c, xs) for c, xs in blocks.items() if c != 'lightgray'],
    key=lambda item: np.mean(item[1]),
)
for cluster_idx, (color, xs) in enumerate(ordered_blocks, start=0):
    ax.text(np.mean(xs), -1.5, f'Кластер {cluster_idx}',
            ha='center', va='top', fontsize=11, fontweight='bold',
            bbox=dict(boxstyle='round,pad=0.3', facecolor=color,
                      alpha=0.6, edgecolor='black'))

ax.axhline(y=THRESHOLD, color='red', linestyle='--', linewidth=1.6)
ax.text(ax.get_xlim()[1] * 0.99, THRESHOLD + 0.4,
        f'Порог = {THRESHOLD}: ниже него кластеры не сливаются',
        ha='right', va='bottom', fontsize=10, color='red',
        bbox=dict(boxstyle='round,pad=0.3', facecolor='white',
                  edgecolor='red', alpha=0.95))

ax.set_title('Дендрограмма клиентов (иерархическая кластеризация)\n'
             'Читается снизу вверх: чем ниже слияние, тем более похожи клиенты',
             fontsize=13)
