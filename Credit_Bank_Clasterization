# 2. Генерация датасета клиентов МСБ

np.random.seed(42)

def generate_client_dataset(n_samples=3000):
    """Генерация данных клиентов для кластеризации"""

    # Базовые характеристики клиентов
    business_types = ['IT', 'Торговля', 'Производство', 'Услуги', 'Строительство', 'Логистика', 'Сельское хозяйство']
    regions = ['Москва', 'Санкт-Петербург', 'Новосибирск', 'Екатеринбург', 'Казань', 'Нижний Новгород', 'Челябинск']

    data = {
        'client_id': [f'CL_{i:05d}' for i in range(n_samples)],
        'business_type': np.random.choice(business_types, n_samples),
        'region': np.random.choice(regions, n_samples),

        # Финансовые показатели
        'annual_revenue': np.random.uniform(100000, 100000000, n_samples).round(0),
        'business_age_years': np.random.uniform(1, 20, n_samples).round(1),
        'employees': np.random.randint(1, 200, n_samples),
        'profit_margin': np.random.uniform(0.02, 0.35, n_samples).round(3),

        # Кредитная история
        'credit_score': np.random.randint(300, 850, n_samples),
        'existing_loans': np.random.randint(0, 5, n_samples),
        'total_debt': np.random.uniform(0, 50000000, n_samples).round(0),
        'default_history': np.random.choice([0, 1], n_samples, p=[0.85, 0.15]),

        # Поведенческие метрики
        'transaction_frequency': np.random.randint(5, 200, n_samples),
        'average_check': np.random.uniform(1000, 500000, n_samples).round(0),
        'customer_lifetime_months': np.random.randint(3, 120, n_samples),

        # Запрашиваемый кредит
        'requested_loan': np.random.uniform(100000, 15000000, n_samples).round(0),
        'requested_term': np.random.choice([12, 24, 36, 48, 60], n_samples),
    }

    df = pd.DataFrame(data)

    # Добавляем скрытые кластеры для реалистичности
    # Кластер 1: Стабильные предприятия с высокой выручкой
    idx1 = np.random.choice(n_samples, size=int(n_samples*0.25), replace=False)
    df.loc[idx1, 'annual_revenue'] *= np.random.uniform(2, 5, len(idx1))
    df.loc[idx1, 'credit_score'] += np.random.randint(50, 150, len(idx1))
    df.loc[idx1, 'profit_margin'] += np.random.uniform(0.05, 0.15, len(idx1))

    # Кластер 2: Рискованные стартапы
    idx2 = np.random.choice(n_samples, size=int(n_samples*0.15), replace=False)
    df.loc[idx2, 'business_age_years'] = np.random.uniform(0.5, 3, len(idx2))
    df.loc[idx2, 'default_history'] = 1
    df.loc[idx2, 'credit_score'] -= np.random.randint(50, 150, len(idx2))
    df.loc[idx2, 'profit_margin'] = np.random.uniform(-0.05, 0.05, len(idx2))

    # Кластер 3: Крупные заемщики
    idx3 = np.random.choice(n_samples, size=int(n_samples*0.20), replace=False)
    df.loc[idx3, 'requested_loan'] *= np.random.uniform(2, 4, len(idx3))
    df.loc[idx3, 'employees'] += np.random.randint(50, 150, len(idx3))
    df.loc[idx3, 'annual_revenue'] *= np.random.uniform(1.5, 3, len(idx3))

    # Кластер 4: Лояльные клиенты с долгой историей
    idx4 = np.random.choice(n_samples, size=int(n_samples*0.15), replace=False)
    df.loc[idx4, 'customer_lifetime_months'] = np.random.randint(60, 120, len(idx4))
    df.loc[idx4, 'transaction_frequency'] += np.random.randint(50, 100, len(idx4))
    df.loc[idx4, 'default_history'] = 0

    return df

# Генерируем данные
df = generate_client_dataset(3000)
print(f"Сгенерировано {len(df)} клиентов")
print("\nПервые 5 записей:")
print(df.head())

# 3. Предобработка данных для кластеризации

# Выбираем признаки для кластеризации
features_for_clustering = [
    'annual_revenue',
    'business_age_years',
    'employees',
    'profit_margin',
    'credit_score',
    'existing_loans',
    'total_debt',
    'default_history',
    'transaction_frequency',
    'average_check',
    'customer_lifetime_months',
    'requested_loan',
    'requested_term'
]

# Кодируем категориальные признаки
le_business = LabelEncoder()
le_region = LabelEncoder()
df['business_type_encoded'] = le_business.fit_transform(df['business_type'])
df['region_encoded'] = le_region.fit_transform(df['region'])

# Добавляем закодированные признаки
features_for_clustering.extend(['business_type_encoded', 'region_encoded'])

# Создаем синтетические признаки
df['debt_to_revenue'] = df['total_debt'] / (df['annual_revenue'] + 1)
df['loan_to_revenue'] = df['requested_loan'] / (df['annual_revenue'] + 1)
df['revenue_per_employee'] = df['annual_revenue'] / (df['employees'] + 1)
df['transaction_activity'] = df['transaction_frequency'] / (df['customer_lifetime_months'] + 1)

features_for_clustering.extend(['debt_to_revenue', 'loan_to_revenue', 'revenue_per_employee', 'transaction_activity'])

# Подготовка данных
X = df[features_for_clustering].copy()

# Обработка выбросов (логарифмирование)
for col in ['annual_revenue', 'total_debt', 'requested_loan', 'average_check']:
    X[f'{col}_log'] = np.log1p(X[col])
    features_for_clustering.append(f'{col}_log')

# Масштабирование
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
X_scaled_df = pd.DataFrame(X_scaled, columns=X.columns)

print(f"Размерность данных: {X_scaled_df.shape}")
print(f"Количество признаков: {X_scaled_df.shape[1]}")

# 4. Определение оптимального числа кластеров

# Метод локтя
inertias = []
silhouette_scores = []
calinski_scores = []
davies_scores = []

K_range = range(2, 11)

for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = kmeans.fit_predict(X_scaled_df)

    inertias.append(kmeans.inertia_)
    silhouette_scores.append(silhouette_score(X_scaled_df, labels))
    calinski_scores.append(calinski_harabasz_score(X_scaled_df, labels))
    davies_scores.append(davies_bouldin_score(X_scaled_df, labels))

# Визуализация
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
fig.suptitle('Определение оптимального числа кластеров', fontsize=16)

# Метод локтя
axes[0,0].plot(K_range, inertias, 'bo-', linewidth=2)
axes[0,0].set_xlabel('Число кластеров')
axes[0,0].set_ylabel('Инерция')
axes[0,0].set_title('Метод локтя')
axes[0,0].grid(True, alpha=0.3)

# Silhouette
axes[0,1].plot(K_range, silhouette_scores, 'ro-', linewidth=2)
axes[0,1].set_xlabel('Число кластеров')
axes[0,1].set_ylabel('Silhouette Score')
axes[0,1].set_title('Коэффициент силуэта')
axes[0,1].grid(True, alpha=0.3)

# Calinski-Harabasz
axes[1,0].plot(K_range, calinski_scores, 'go-', linewidth=2)
axes[1,0].set_xlabel('Число кластеров')
axes[1,0].set_ylabel('Calinski-Harabasz Score')
axes[1,0].set_title('Индекс Калински-Харабаш')
axes[1,0].grid(True, alpha=0.3)

# Davies-Bouldin
axes[1,1].plot(K_range, davies_scores, 'mo-', linewidth=2)
axes[1,1].set_xlabel('Число кластеров')
axes[1,1].set_ylabel('Davies-Bouldin Score')
axes[1,1].set_title('Индекс Дэвиса-Болдина')
axes[1,1].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

# Вывод оптимального числа
optimal_k = K_range[np.argmax(silhouette_scores)]
print(f"Оптимальное число кластеров по Silhouette: {optimal_k}")
print(f"Лучший Silhouette Score: {max(silhouette_scores):.3f}")

# 5. Применение различных алгоритмов кластеризации

# K-Means
