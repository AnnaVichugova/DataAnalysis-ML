def generate_cfo_dataset(n_samples=300):
    cfo_types = ['Розничный бизнес', 'Корпоративный бизнес', 'ИТ', 'Бэк-офис',
                 'HR', 'Маркетинг', 'Риски', 'Проектный офис', 'Юридический', 'Финансовый']
    divisions = ['Москва', 'Санкт-Петербург', 'Регионы', 'Центральный аппарат']

    data = {
        'cfo_id': [f'CFO_{i:04d}' for i in range(n_samples)],
        'cfo_type': np.random.choice(cfo_types, n_samples),
        'division': np.random.choice(divisions, n_samples),
        'annual_revenue': np.random.uniform(0, 5_000_000_000, n_samples).round(0),
        'direct_expenses': np.random.uniform(50_000_000, 2_000_000_000, n_samples).round(0),
        'indirect_expenses': np.random.uniform(10_000_000, 500_000_000, n_samples).round(0),
        'fte_count': np.random.randint(3, 800, n_samples),
        'budget_utilization_rate': np.random.uniform(0.3, 1.15, n_samples).round(3),
        'capex_rate': np.random.uniform(0, 1.0, n_samples).round(3),
        'prev_revenue': np.random.uniform(0, 4_500_000_000, n_samples).round(0),
        'prev_expenses': np.random.uniform(50_000_000, 2_000_000_000, n_samples).round(0),
    }

    df = pd.DataFrame(data)

    idx1 = np.random.choice(n_samples, size=int(n_samples * 0.20), replace=False)
    df.loc[idx1, 'annual_revenue'] = np.random.uniform(1_500_000_000, 5_000_000_000, len(idx1))
    df.loc[idx1, 'direct_expenses'] = df.loc[idx1, 'annual_revenue'] * np.random.uniform(0.25, 0.45, len(idx1))
    df.loc[idx1, 'fte_count'] = np.random.randint(100, 800, len(idx1))
    df.loc[idx1, 'budget_utilization_rate'] = np.random.uniform(0.7, 0.98, len(idx1))

