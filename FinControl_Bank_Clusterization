# 5b. Обоснование выбора k: устойчивость и интерпретируемость
# ============================================================================
def evaluate_k(k_values, X_scaled, X_raw, n_bootstrap=20, sample_frac=0.8):
    biz_cols = ['cir', 'revenue_per_fte', 'admin_share',
                'expense_outpacing', 'budget_utilization_rate', 'capex_rate']

    rows = []
    n = len(X_scaled)

    for k in k_values:
        km = KMeans(n_clusters=k, random_state=42, n_init=20)
        labels_full = km.fit_predict(X_scaled)

        sil = silhouette_score(X_scaled, labels_full)
        ch = calinski_harabasz_score(X_scaled, labels_full)
        db = davies_bouldin_score(X_scaled, labels_full)

        # Инерция — числовой аналог «метода локтя»:
        # суммарный квадрат расстояний точек до центров своих кластеров.
        inertia = float(km.inertia_)

        aris = []
        for _ in range(n_bootstrap):
            idx = resample(np.arange(n), replace=False,
                           n_samples=int(n * sample_frac), random_state=None)
            km_b = KMeans(n_clusters=k, random_state=42, n_init=10)
            km_b.fit(X_scaled[idx])
            labels_pred_full = km_b.predict(X_scaled)
            aris.append(adjusted_rand_score(labels_full, labels_pred_full))
        stability = float(np.mean(aris))

        eta_list = []
        for col in biz_cols:
            vals = X_raw[col].astype(float)
            grand_mean = vals.mean()
            ss_total = ((vals - grand_mean) ** 2).sum()
            ss_between = 0.0
            for c in np.unique(labels_full):
                mask = labels_full == c
                if mask.sum() == 0:
                    continue
                ss_between += mask.sum() * (vals[mask].mean() - grand_mean) ** 2
            eta = ss_between / ss_total if ss_total > 0 else 0.0
            eta_list.append(eta)
        interpretability = float(np.mean(eta_list))

        rows.append({
            'k': k,
            'inertia': round(inertia, 2),
            'silhouette': round(sil, 4),
            'calinski': round(ch, 2),
            'davies_bouldin': round(db, 4),
            'stability_ari': round(stability, 4),
            'interpretability_eta2': round(interpretability, 4),
        })
    return pd.DataFrame(rows)


