def classify_cluster(row, profile, used_types):
    rev = row['annual_revenue']
    cir = row['cir']
    capex = row['capex_rate']
    outpacing = row['expense_outpacing']
    util = row['budget_utilization_rate']

    if outpacing > 0.1 and util > 1.0:
        base = "Зона риска / Аномальные затраты"
        strategy = ("Срочный аудит затрат, блокировка перерасходованных лимитов, "
                    "уведомление руководителя ЦФО, эскалация в Правление")
        risk = 0.9
    elif capex > 0.5 and rev < 200_000_000:
        base = "Инвестиционные/Проектные ЦФО"
        strategy = ("Контроль план-факта капитальных затрат (CAPEX), "
                    "поэтапное согласование траншей, мониторинг окупаемости проекта")
        risk = 0.4
    elif rev > 500_000_000 and cir < 0.85:
        # Если доход очень высокий, называем "крупными" драйверами
        if rev > 2_000_000_000:
            base = "Драйверы эффективности (крупные)"
        else:
            base = "Драйверы эффективности (средние)"
        strategy = ("Поддерживающие условия, бенчмаркинг (сравнение с лучшими), "
                    "тиражирование лучших практик, рассмотреть расширение лимитов")
        risk = 0.1
    elif rev < 100_000_000:
        base = "Центры поддержки"
        strategy = ("Жёсткий контроль косвенных расходов, нормирование FTE (численности), "
                    "периодический пересмотр аллокации (распределения затрат)")
        risk = 0.3
    else:
        base = "Смешанный профиль"
        strategy = "Требуется ручной анализ"
        risk = 0.5

    # Страховка: если даже с подтипами имя занято — добавляем номер
    final_type = base
    n = 1
    while final_type in used_types:
        n += 1
        final_type = f"{base} ({n})"
    return final_type, strategy, risk


# --- Исправленный цикл с передачей used_types ---
