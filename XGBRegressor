def get_customer_history_reg(customer_id, current_app_date, current_app_number=None):
    """Возвращает историю клиента по ЗАЯВКАМ и ДОГОВОРАМ, которые были ДО current_app_date"""
    if not isinstance(current_app_date, pd.Timestamp):
        current_app_date = pd.to_datetime(current_app_date)

    # Заявки клиента до указанной даты
    customer_apps = df_applications[
        (df_applications['Клиент'] == customer_id) &
        (df_applications['app_date_dt'].notna()) &
        (df_applications['app_date_dt'] < current_app_date)
    ].copy()
    if current_app_number:
        customer_apps = customer_apps[customer_apps['Номер'] != current_app_number]

    total_apps = len(customer_apps)
    successful = sum(1 for _, app in customer_apps.iterrows() if app['Номер'] in app_to_amount)
    conversion_rate = successful / total_apps if total_apps > 0 else 0

    # Данные клиента (ИНН, название)
    cust_row = df_customers[df_customers['customer_id'] == customer_id]
    if len(cust_row) == 0:
        return default_customer_history()
    cust_inn = cust_row.iloc[0]['customer_inn']
    cust_name = cust_row.iloc[0]['customer_name']

    # Договоры клиента до даты (используем глобальный customer_contracts, но с учётом дат)
    hist_contracts = customer_contracts[
        ((customer_contracts['counterparty_inn'] == cust_inn) |
         (customer_contracts['counterparty_name'] == cust_name)) &
        (customer_contracts['doc_date_dt'].notna()) &
        (customer_contracts['doc_date_dt'] < current_app_date)
    ].copy()

    amounts = hist_contracts['document_amount'].dropna()
    avg_amount = amounts.mean() if len(amounts) > 0 else 0
    contract_count = len(amounts)
    signed = (hist_contracts['document_status'] == 'подписан').sum() if len(hist_contracts) > 0 else 0
    signed_rate = signed / len(hist_contracts) if len(hist_contracts) > 0 else 0

    # Содержимое договоров
    avg_order_qty = 0
    if len(hist_contracts) > 0 and len(df_contracts_content) > 0:
        merged = hist_contracts.merge(
            df_contracts_content,
            left_on='document_number',
            right_on='contract_number',
            how='inner'
        )
        if len(merged) > 0:
            avg_order_qty = merged.groupby('document_number')['quantity'].sum().mean()

    # Платежи по договорам
    avg_payment = 0
    if len(hist_contracts) > 0 and len(df_payments) > 0:
        incoming = df_payments[df_payments['Тип'] == 'Входящий'].copy()
        if 'Дата' in incoming.columns:
            incoming['Дата'] = pd.to_datetime(incoming['Дата'], errors='coerce')
            payments_before = incoming[incoming['Дата'] < current_app_date]
            contract_payments = []
            for doc_num in hist_contracts['document_number']:
                paid = payments_before[payments_before['Основание'] == doc_num]['Сумма'].sum()
                if paid > 0:
                    contract_payments.append(paid)
            avg_payment = np.mean(contract_payments) if contract_payments else 0

    return {
        'total_applications': total_apps,
        'successful_applications': successful,
        'conversion_rate': conversion_rate,
        'avg_contract_amount': avg_amount,
        'contract_count': contract_count,
        'contract_signed_rate': signed_rate,
        'avg_order_quantity': avg_order_qty,
        'avg_contract_payment_sum': avg_payment
    }

