# ========== 8. ФУНКЦИЯ ПРЕДСКАЗАНИЯ ДЛЯ НОВОЙ ЗАЯВКИ ==========
def predict_contract_amount(customer_id, manager_id, source, content, date=None, verbose=False):
    if date is None:
        date = pd.Timestamp.now()
    else:
        date = pd.to_datetime(date)

    cust_hist = get_customer_history_reg(customer_id, date, current_app_number=None)
    mgr_hist = get_manager_history_reg(manager_id, date)

    equipment_cat = extract_equipment_type(content)
    urgency = extract_urgency(content)
    politeness = extract_politeness(content)
    quantity = extract_quantity(content)

    cust_row = df_customers[df_customers['customer_id'] == customer_id]
    customer_type = cust_row['customer_type'].iloc[0] if len(cust_row) > 0 else 'unknown'
    customer_status = cust_row['customer_status'].iloc[0] if len(cust_row) > 0 else 'unknown'

    mgr_row = df_managers[df_managers['manager_id'] == manager_id]
    manager_spec = mgr_row['manager_specialization'].iloc[0] if len(mgr_row) > 0 else 'unknown'

    hour = date.hour
    day_of_week = date.dayofweek
    is_weekend = 1 if day_of_week >= 5 else 0
    days_since_start = (date - pd.Timestamp('2024-01-01')).days

    features_dict = {
        'Источник': source,
        'customer_type': customer_type,
        'customer_status': customer_status,
        'manager_specialization': manager_spec,
        'equipment_category': equipment_cat,
        'urgency': urgency,
        'politeness_score': politeness,
        'request_quantity': quantity,
        'total_applications': cust_hist['total_applications'],
        'successful_applications': cust_hist['successful_applications'],
        'conversion_rate': cust_hist['conversion_rate'],
        'avg_contract_amount': cust_hist['avg_contract_amount'],
        'contract_count': cust_hist['contract_count'],
        'contract_signed_rate': cust_hist['contract_signed_rate'],
        'avg_order_quantity': cust_hist['avg_order_quantity'],
        'avg_contract_payment_sum': cust_hist['avg_contract_payment_sum'],
        'total_handled': mgr_hist['total_handled'],
        'manager_conversion_rate': mgr_hist['manager_conversion_rate'],
        'manager_avg_contract_amount': mgr_hist['manager_avg_contract_amount'],
        'manager_contracts_count': mgr_hist['manager_contracts_count'],
        'hour': hour,
        'day_of_week': day_of_week,
        'is_weekend': is_weekend,
        'days_since_start': days_since_start,
    }

    df_new = pd.DataFrame([features_dict])
    for col in categorical_cols_reg:
        if col in df_new.columns:
            val = df_new[col].iloc[0]
            le = label_encoders_reg[col]
            if 'unknown' not in le.classes_:
                le.classes_ = np.append(le.classes_, 'unknown')
            if val not in le.classes_:
                val = 'unknown'
            encoded = le.transform([val])[0]
            df_new[col+'_encoded'] = encoded
            df_new = df_new.drop(columns=[col])
        else:
            le = label_encoders_reg[col]
            if 'unknown' not in le.classes_:
                le.classes_ = np.append(le.classes_, 'unknown')
            df_new[col+'_encoded'] = le.transform(['unknown'])[0]

    X_new = df_new[feature_cols_reg]
    pred_log = reg_model.predict(X_new)[0]
    pred_amount = np.expm1(pred_log)

    if verbose:
        print(f"\n ========  История клиента ===== \n заявок={cust_hist['total_applications']}, "
              f"успешных = {cust_hist['successful_applications']}, "
              f"ср.сумма = {cust_hist['avg_contract_amount']:,.0f}")
        print(f" =========== Прогнозируемая сумма заявки ==== \n {pred_amount:,.0f} руб.")
    return pred_amount

