np.random.seed(42)

def generate_credit_dataset(n_samples=5000):
    """Генерация датасета по кредитованию малого бизнеса"""

    # Базовые данные
    data = {
        'application_id': [f'APP_{i:05d}' for i in range(n_samples)],
        'business_name': [f'ООО "Бизнес-{i}"' for i in range(n_samples)],

        # Финансовые показатели
        'annual_revenue': np.random.uniform(500000, 50000000, n_samples).round(0),
        'business_age_months': np.random.randint(3, 240, n_samples),
        'employees_count': np.random.randint(1, 100, n_samples),

        # Кредитные параметры
        'loan_amount': np.random.uniform(100000, 10000000, n_samples).round(0),
        'loan_term_months': np.random.choice([12, 24, 36, 48, 60], n_samples),
        'interest_rate': np.random.uniform(8, 25, n_samples).round(2),

        # Финансовые коэффициенты
        'debt_to_income_ratio': np.random.uniform(0, 0.8, n_samples).round(3),
        'credit_score': np.random.randint(300, 850, n_samples),
        'default_history': np.random.choice([0, 1], n_samples, p=[0.7, 0.3]),
    }

    df = pd.DataFrame(data)

    # Добавляем текстовые поля (неструктурированные данные)
    business_types = ['IT', 'Торговля', 'Производство', 'Услуги', 'Строительство', 'Логистика']
    purposes = ['Пополнение оборотных средств', 'Приобретение оборудования',
                'Расширение бизнеса', 'Рефинансирование', 'Закупка товаров']

    df['business_type'] = np.random.choice(business_types, n_samples)
    df['loan_purpose'] = np.random.choice(purposes, n_samples)

    # Создаем неструктурированные тексты (имитация выписок и деклараций)
    def generate_unstructured_text(row):
        text = f"""
        АНКЕТА ЗАЕМЩИКА
        Наименование: {row['business_name']}
        ИНН: {np.random.randint(1000000000, 9999999999)}
        КПП: {np.random.randint(100000000, 999999999)}
        Вид деятельности: {row['business_type']}

        ФИО руководителя: {np.random.choice(['Иванов И.И.', 'Петров П.П.', 'Сидоров С.С.', 'Козлов К.К.'])}
        Телефон: 8-9{np.random.randint(100000000, 999999999)}

        ФИНАСОВАЯ ОТЧЕТНОСТЬ
        Выручка за год: {row['annual_revenue']:,} руб.
        Прибыль: {np.random.randint(100000, 10000000):,} руб.
        Кредиторская задолженность: {np.random.randint(0, 5000000):,} руб.

        НАЛОГОВАЯ ДЕКЛАРАЦИЯ
        Налог на прибыль: {np.random.randint(10000, 1000000):,} руб.
        НДС: {np.random.randint(0, 500000):,} руб.
        Страховые взносы: {np.random.randint(5000, 500000):,} руб.

        ВЫПИСКА ИЗ РАСЧЕТНОГО СЧЕТА
        Среднемесячный оборот: {np.random.randint(50000, 5000000):,} руб.
        Количество транзакций: {np.random.randint(10, 200)}
        Остаток на счете: {np.random.randint(0, 3000000):,} руб.
        """
        return text

    df['unstructured_text'] = df.apply(generate_unstructured_text, axis=1)

    # Целевая переменная (дефолт или нет)
    # Используем логику для генерации реалистичной зависимости
    risk_score = (
        - df['credit_score'] / 1000 +
        df['debt_to_income_ratio'] * 2 +
        (df['loan_amount'] / df['annual_revenue']) * 0.5 +
        df['default_history'] * 0.5
    )

    # Добавляем случайный шум
    risk_noise = np.random.normal(0, 0.3, n_samples)
    risk_score = risk_score + risk_noise

    # Вероятность дефолта
    default_prob = 1 / (1 + np.exp(-risk_score * 3))
    df['default'] = np.random.binomial(1, default_prob)

    # Добавляем признаки для автоматического извлечения (имитация работы OCR/NLP)
    df['extracted_inn'] = [np.random.randint(1000000000, 9999999999) for _ in range(n_samples)]
    df['extracted_ceo_name'] = np.random.choice(['Иванов Иван', 'Петров Петр', 'Сидоров Сергей'], n_samples)
    df['extracted_avg_monthly_revenue'] = df['annual_revenue'] / 12 * np.random.uniform(0.8, 1.2, n_samples)

    return df

