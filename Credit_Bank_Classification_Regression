def interpret_feature(feature):
    """Возвращает (интерпретация, как влияет на риск)."""
    if feature == 'credit_score':
        return ('Кредитный скоринг — основной предиктор дефолта',
                'Чем выше скоринг, тем ниже риск дефолта')
    if feature in ('debt_to_income_ratio', 'debt_to_revenue'):
        return ('Долговая нагрузка — критический показатель',
                'Высокий DTI значительно повышает риск дефолта')
    if feature == 'default_history':
        return ('Прошлые дефолты — сильнейший предиктор',
                'Наличие дефолтов в истории кратно увеличивает риск')
    if feature == 'loan_to_revenue_ratio':
        return ('Соотношение кредита к выручке',
                'Чем выше сумма кредита относительно выручки, тем выше риск')
    if feature == 'payment_to_revenue_ratio':
        return ('Доля платежа в выручке',
                'Высокий показатель указывает на платёжную нагрузку')
    if feature == 'annual_revenue':
        return ('Размер бизнеса',
                'Более крупные компании обычно стабильнее и реже уходят в дефолт')
    if feature == 'business_age_months':
        return ('Возраст бизнеса',
                'Молодые компании подвержены более высоким рискам')
    if feature == 'employees_count':
        return ('Количество сотрудников',
                'Отражает масштаб и устойчивость бизнеса')
    if feature == 'extracted_avg_turnover':
        return ('Оборот по счёту (из документов)',
                'Высокий оборот — признак активного бизнеса')
    if feature == 'extracted_balance':
        return ('Остаток на счёте (из выписки)',
                'Хороший остаток — буфер ликвидности')
    if feature == 'extracted_revenue':
        return ('Выручка (из налоговой декларации)',
                'Подтверждает реальный доход бизнеса')
    if feature == 'extracted_profit_tax':
        return ('Налог на прибыль (из декларации)',
                'Отражает реальную прибыльность')
    if feature in ('business_type_encoded', 'loan_purpose_encoded'):
        return ('Категориальный признак',
                'Влияет на риск через специфику бизнеса или цель кредита')
    if feature == 'monthly_payment':
        return ('Расчётный ежемесячный платёж',
                'Влияет на платёжеспособность заёмщика')
    if feature == 'revenue_per_employee':
        return ('Эффективность бизнеса (доход на 1 сотрудника)',
                'Чем выше эффективность, тем ниже риски')
    return ('Финансовый показатель', 'Влияет на общий риск-профиль заёмщика')


for idx, row in feature_importance_class.head(15).iterrows():
    interp, impact = interpret_feature(row['feature'])
    print(f"{idx + 1:2d}. {row['feature_ru']} ({row['feature']})")
    print(f"    Важность (Gini): {row['importance']:.4f}")
    print(f"    Важность (Permutation): {row['permutation_importance']:.4f}")
    print(f"    → {interp}")
    print(f"    → {impact}")
    print()

