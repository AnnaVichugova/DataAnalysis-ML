}

group_importance = {}
for group, feats in groups.items():
    total = 0.0
    for f in feats:
        row = feature_importance_class[feature_importance_class['feature'] == f]
        if len(row) > 0:
            total += row['importance'].values[0]
    group_importance[group] = total

