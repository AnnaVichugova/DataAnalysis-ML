# 4. Извлечение фич из неструктурированных текстов (автоматизация первичного скоринга)

def extract_features_from_text(text):
    """Автоматическое извлечение ключевых параметров из текста"""
    features = {}

    # Извлечение выручки
    revenue_match = re.search(r'Выручка за год:\s*([\d,]+)', text)
    if revenue_match:
        features['extracted_revenue'] = float(revenue_match.group(1).replace(',', ''))

    # Извлечение налога на прибыль
    tax_match = re.search(r'Налог на прибыль:\s*([\d,]+)', text)
    if tax_match:
        features['extracted_profit_tax'] = float(tax_match.group(1).replace(',', ''))

    # Извлечение среднемесячного оборота
    turnover_match = re.search(r'Среднемесячный оборот:\s*([\d,]+)', text)
    if turnover_match:
        features['extracted_avg_turnover'] = float(turnover_match.group(1).replace(',', ''))

    # Извлечение количества транзакций
    trans_match = re.search(r'Количество транзакций:\s*(\d+)', text)
    if trans_match:
        features['extracted_transactions'] = int(trans_match.group(1))

    # Извлечение остатка на счете
    balance_match = re.search(r'Остаток на счете:\s*([\d,]+)', text)
    if balance_match:
        features['extracted_balance'] = float(balance_match.group(1).replace(',', ''))

    return features

