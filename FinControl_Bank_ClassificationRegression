    # --- 1. Извлечение данных ---
    print("\n1. ЭТАП ИЗВЛЕЧЕНИЯ ДАННЫХ ИЗ ДОКУМЕНТОВ")
    print("-" * 90)
    print(f"  ✓ Тип ЦФО:                         {application_data['cfo_type']}")
    print(f"  ✓ История отклонений:              {application_data['history_deviation_pct']:.1%}")
    print(f"  ✓ Заявок на доп. финансирование:   {application_data['supplementary_requests_count']} шт.")
    print(f"  ✓ Инфляция по статьям:             {application_data['inflation_rate_pct']:.1%}")
    print(f"  ✓ Стадия выполнения проектов:      {application_data['project_completion_stage']:.0%}")
    print(f"  ✓ Доходы и плановые расходы:       {application_data['annual_revenue']:,.0f} / "
          f"{application_data['planned_expenses']:,.0f} руб.")
    print("  Время обработки: < 1 секунды (вручную — часы)")

    # --- 2. Оценка риска перерасхода ---
    print("\n2. ЭТАП ОЦЕНКИ РИСКА ПЕРЕРАСХОДА (классификация)")
    print("-" * 90)
    sample = pd.DataFrame([{
        'history_deviation_pct': application_data['history_deviation_pct'],
        'supplementary_requests_count': application_data['supplementary_requests_count'],
        'inflation_rate_pct': application_data['inflation_rate_pct'],
        'project_completion_stage': application_data['project_completion_stage'],
        'annual_revenue': application_data['annual_revenue'],
        'planned_expenses': application_data['planned_expenses'],
        'cfo_type_encoded': 0,
        'plan_vs_revenue_ratio': application_data['planned_expenses'] / (application_data['annual_revenue'] + 1),
        'inflation_x_requests': application_data['inflation_rate_pct'] * application_data['supplementary_requests_count'],
    }])
    sample_scaled = scaler.transform(sample[X.columns])
    overrun_prob = best_model.predict_proba(sample_scaled)[0, 1]

    if overrun_prob < 0.10:
        risk_level = "НИЗКИЙ"
        risk_comment = ("Модель уверена: ЦФО с высокой долей вероятности уложится "
                        "в лимит. Расходы прогнозируются в рамках плана.")
        action_short = "Одобрить без дополнительных проверок"
        action_full = ("Заявку можно одобрить в стандартном порядке. "
                       "Дополнительные согласования не требуются.")
    elif overrun_prob < 0.30:
        risk_level = "УМЕРЕННЫЙ"
        risk_comment = ("Модель видит небольшой риск перерасхода. Возможны "
                        "отклонения, но в пределах допустимого.")
        action_short = "Одобрить с плановым мониторингом"
        action_full = ("Заявку можно одобрить, но стоит поставить ЦФО на "
                       "еженедельный контроль план-факта.")
    elif overrun_prob < 0.60:
        risk_level = "ПОВЫШЕННЫЙ"
        risk_comment = ("Модель видит заметный риск перерасхода. Есть признаки, "
                        "что планового лимита может не хватить.")
        action_short = "Одобрить с условиями и контролем"
        action_full = ("Рекомендуется одобрить с условием: обязательная сверка "
                       "план-факта раз в две недели и уведомление ФД при "
                       "отклонении более 5%.")
    elif overrun_prob < 0.85:
        risk_level = "ВЫСОКИЙ"
        risk_comment = ("Модель оценивает риск перерасхода как высокий. "
                        "Вероятно, ЦФО выйдет за лимит более чем на 10%.")
        action_short = "Требуется аудит до одобрения"
        action_full = ("Заявку стоит направить на аудит в ФД: проверить "
                       "обоснование расходов, историю отклонений и заявки "
                       "на доп. финансирование.")
    else:
        risk_level = "КРИТИЧЕСКИЙ"
        risk_comment = ("Модель почти уверена: ЦФО выйдет за лимит. "
                        "Совокупность признаков указывает на перерасход.")
        action_short = "Эскалация в Правление, блокировка до аудита"
        action_full = ("Необходимо эскалировать заявку в Правление, "
                       "заблокировать новые заявки ЦФО до завершения аудита "
                       "и уведомить руководителя подразделения.")

    print(f"  → Вероятность перерасхода: {overrun_prob:.1%}")
    print(f"  → Уровень риска: {risk_level}")
    print(f"  → Что это значит: {risk_comment}")
    print(f"  → Решение: {action_short}")
    print(f"  → Подробно: {action_full}")

    # --- 3. Прогноз суммы расходов ---
    print("\n3. ЭТАП ПРОГНОЗА СУММЫ РАСХОДОВ (регрессия)")
    print("-" * 90)
    pred_expenses = reg_model.predict(sample_scaled)[0]
    deviation_from_plan = (pred_expenses / application_data['planned_expenses'] - 1) * 100
    print(f"  → Плановые расходы:             {application_data['planned_expenses']:,.0f} руб.")
    print(f"  → Прогноз фактических расходов: {pred_expenses:,.0f} руб.")
    print(f"  → Отклонение прогноза от плана: {deviation_from_plan:+.1f}%")
    if deviation_from_plan > 10:
        print("  → Прогноз превышает план более чем на 10% — ожидается перерасход.")
    elif deviation_from_plan > 0:
        print("  → Прогноз в пределах плана, но с небольшим отклонением.")
    else:
        print("  → Прогноз ниже плана — ожидается экономия бюджета.")

    # --- 4. Автоматическое создание задач ---
    print("\n4. АВТОМАТИЧЕСКОЕ СОЗДАНИЕ ЗАДАЧ В ТРЕКЕРЕ")
    print("-" * 90)
    tasks = [
        "✓ Задача для ФД: проверить обоснование расходов",
        "✓ Задача для Проектного офиса: обновить план-факт",
        "✓ Уведомление руководителю ЦФО: решение по заявке",
    ]
    if overrun_prob > 0.5 or deviation_from_plan > 10:
        tasks.append("✓ Задача для Правления: согласование перерасхода")
    for t in tasks:
        print(f"  {t}")

    # --- 5. Проверка прогноза на реальных данных ---
    print("\n5. ПРОВЕРКА ПРОГНОЗА (реальность, которая открылась позже)")
    print("-" * 90)
    actual_overrun = application_data['budget_overrun']
    actual_expenses = application_data['actual_expenses']
    actual_deviation = (actual_expenses / application_data['planned_expenses'] - 1) * 100

    print(f"  Фактические расходы:            {actual_expenses:,.0f} руб.")
    print(f"  Фактическое отклонение от плана: {actual_deviation:+.1f}%")
    print(f"  Фактический перерасход > 10%:   "
          f"{'ДА' if actual_overrun == 1 else 'НЕТ'}")

    predicted_overrun = 1 if overrun_prob > 0.5 else 0
    if predicted_overrun == actual_overrun:
        verdict = "СОВПАЛО — модель предсказала верно"
    else:
        if actual_overrun == 1 and predicted_overrun == 0:
            verdict = ("ОШИБКА — модель пропустила перерасход "
                       "(False Negative, самый дорогой тип ошибки)")
        else:
            verdict = ("ОШИБКА — модель предсказала перерасход, "
                       "но фактически его не было (False Positive, "
                       "лишняя проверка)")
    print(f"  Вердикт:                        {verdict}")

    error_abs = abs(pred_expenses - actual_expenses)
    error_pct = error_abs / actual_expenses * 100 if actual_expenses > 0 else 0
    print(f"  Ошибка прогноза суммы:           {error_abs:,.0f} руб. ({error_pct:.1f}%)")

    # --- 6. Итоговая сводка «было / стало» ---
    print("\n" + "=" * 90)
    print("ИТОГ: СРАВНЕНИЕ РУЧНОЙ И АВТОМАТИЧЕСКОЙ ОБРАБОТКИ")
    print("=" * 90)
    print(f"  {'Параметр':<40} {'Ручная обработка':<22} {'Автоматизация'}")
    print(f"  {'-'*40} {'-'*22} {'-'*20}")
    print(f"  {'Время обработки':<40} {'2–3 дня':<22} {'< 5 секунд'}")
    print(f"  {'Риск перерасхода':<40} {'субъективная оценка':<22} {overrun_prob:.1%} ({risk_level})")
    print(f"  {'Прогноз расходов':<40} {'вручную по формуле':<22} {pred_expenses:,.0f} руб.")
    print(f"  {'Создание задач':<40} {'забывают':<22} {'автоматически'}")
    print(f"  {'Ошибки расчётов':<40} {'высокие':<22} {'исключены'}")
    print("=" * 90)

    return {
        'overrun_probability': overrun_prob,
        'risk_level': risk_level,
        'decision': action_short,
        'predicted_expenses': pred_expenses,
        'actual_overrun': actual_overrun,
        'prediction_correct': predicted_overrun == actual_overrun,
    }


