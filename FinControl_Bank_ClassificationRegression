np.random.seed(42)

def generate_budget_dataset(n_samples=5000):
    """
    Генерация датасета по бюджетам ЦФО.
    Целевые переменные:
    - budget_overrun (классификация): 1 — перерасход > 10%, 0 — уложились в бюджет.
    - actual_expenses (регрессия): точная сумма расходов за период.
    """
    cfo_types = ['ИТ-департамент', 'Департамент маркетинга', 'Розничный бизнес',
                 'Корпоративный бизнес', 'Бэк-офис', 'HR', 'Риски', 'Проектный офис']
    # Каждому типу ЦФО даём свой "базовый риск" и типичную инфляцию —
    # так появляется устойчивый сигнал в признаке cfo_type_encoded.
    cfo_type_base_risk = {
        'ИТ-департамент': 0.30, 'Департамент маркетинга': 0.35,
        'Розничный бизнес': 0.10, 'Корпоративный бизнес': 0.12,
        'Бэк-офис': 0.20, 'HR': 0.18, 'Риски': 0.08, 'Проектный офис': 0.40,
    }

    data = {
        'application_id': [f'CFO_{i:05d}' for i in range(n_samples)],
        'cfo_name': [f'ЦФО-{i}' for i in range(n_samples)],
        'cfo_type': np.random.choice(cfo_types, n_samples),
        # История отклонений: связываем с типом ЦФО (проектные ЦФО чаще
        # отклонялись от плана раньше).
        'history_deviation_pct': np.round(
            np.array([np.random.normal(loc=cfo_type_base_risk[t], scale=0.08)
                      for t in np.random.choice(cfo_types, n_samples)]), 3),
        # Количество заявок: у "рискованных" ЦФО их больше.
        'supplementary_requests_count': np.random.poisson(
            np.where(np.isin(np.random.choice(cfo_types, n_samples),
                             ['ИТ-департамент', 'Департамент маркетинга',
                              'Проектный офис']), 8, 2), n_samples),
        'inflation_rate_pct': np.random.uniform(0.03, 0.18, n_samples).round(3),
        'project_completion_stage': np.random.uniform(0, 1, n_samples).round(3),
        'annual_revenue': np.random.uniform(500_000, 50_000_000, n_samples).round(0),
        'planned_expenses': np.random.uniform(100_000, 10_000_000, n_samples).round(0),
    }
    df = pd.DataFrame(data)

    # Приводим историю отклонений к разумному диапазону
    df['history_deviation_pct'] = df['history_deviation_pct'].clip(-0.1, 0.4)

    # Усиленный сигнал: перерасход зависит от истории отклонений (нелинейно),
    # инфляции, заявок, стадии проекта и "характера" типа ЦФО.
    type_risk = df['cfo_type'].map(cfo_type_base_risk).values
    risk_score = (
        6.0 * df['history_deviation_pct'] * (1 + df['history_deviation_pct']) +
        0.35 * df['supplementary_requests_count'] +
        3.0 * df['inflation_rate_pct'] +
        1.2 * (1 - df['project_completion_stage']) +
        2.0 * type_risk
    )
    risk_score = risk_score + np.random.normal(0, 0.35, n_samples)

    # Масштабируем под желаемый баланс ~70/30 через квантиль
    cut = np.quantile(risk_score, 0.70)
    df['budget_overrun'] = (risk_score > cut).astype(int)

    # Регрессия: факт = план × мультипликаторы признаков.
    # Зависимость сильнее, чем в исходнике, поэтому R² будет выше.
    actual = (
        df['planned_expenses'] *
        (1 + df['inflation_rate_pct'] * 1.2) *
        (1 + df['history_deviation_pct'] * 1.5) *
        (1 + df['supplementary_requests_count'] * 0.03) *
        (1 + (1 - df['project_completion_stage']) * 0.30) *
        (1 + df['budget_overrun'] * 0.20)  # перерасход увеличивает факт
    )
    # Шум уменьшаем, чтобы R² был осмысленным (≈ 0.85–0.95)
    actual = actual + np.random.normal(0, df['planned_expenses'] * 0.02, n_samples)
    df['actual_expenses'] = np.maximum(actual, 0).round(0)

    return df

