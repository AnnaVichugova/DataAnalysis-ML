import os
import re
import requests
import json
from langflow.custom import Component
from langflow.io import MessageInput, StrInput, Output
from langflow.schema import Data

class CleanlabRAGEvaluatorYandex(Component):
    display_name = "RAG Evaluator (Yandex OpenAI-Compatible)"
    description = "Оценка качества RAG (Faithfulness и Relevance) через OpenAI-совместимый эндпоинт Yandex Cloud"
    icon = "Gauge"

    inputs = [
        MessageInput(name="query", display_name="Вопрос пользователя (Query)", info="Исходный запрос из Chat Input"),
        MessageInput(name="contexts", display_name="Извлеченный контекст (Contexts)", info="Текст документов из Parser / PGVector"),
        MessageInput(name="response", display_name="Ответ модели (Response)", info="Ответ из Language Model"),
        StrInput(
            name="model", 
            display_name="Model (Full URI)", 
            info="Полный идентификатор модели в формате gpt://<folder_id>/<model_name>/latest", 
            value="gpt-oss-20b/latest",
            required=True,
        ),
        StrInput(
            name="endpoint_url",
            display_name="Endpoint URL (OpenAI-compatible)",
            info="Полный URL OpenAI-совместимого эндпоинта",
            value="https://llm.api.cloud.yandex.net/v1/chat/completions",
            required=True,
        ),
    ]

    outputs = [
        Output(name="results", display_name="Evaluation Results", method="evaluate_rag"),
    ]

    def _extract_text(self, obj) -> str:
        """Глубокое извлечение чистого текста из любых сложных структур Langflow."""
        if not obj:
            return ""
        if isinstance(obj, str):
            return obj
        
        if hasattr(obj, "text") and obj.text:
            return str(obj.text)
            
        if isinstance(obj, dict):
            if "text" in obj and isinstance(obj["text"], str):
                return obj["text"]
            if "data" in obj and isinstance(obj["data"], dict):
                data_part = obj["data"]
                if "text" in data_part and isinstance(data_part["text"], str):
                    return data_part["text"]
                if "content_blocks" in data_part and isinstance(data_part["content_blocks"], list):
                    block_texts = []
                    for block in data_part["content_blocks"]:
                        if isinstance(block, dict) and "text" in block:
                            block_texts.append(str(block["text"]))
                    if block_texts:
                        return "\n".join(block_texts)
            if "content_blocks" in obj and isinstance(obj["content_blocks"], list):
                block_texts = []
                for block in obj["content_blocks"]:
                    if isinstance(block, dict) and "text" in block:
                        block_texts.append(str(block["text"]))
                if block_texts:
                    return "\n".join(block_texts)

        if isinstance(obj, list):
            return "\n".join([self._extract_text(item) for item in obj if item])
            
        if hasattr(obj, "value") and obj.value:
            return str(obj.value)
            
        return str(obj)

    def evaluate_rag(self) -> Data:
        # Извлекаем очищенные текстовые данные
        clean_query = self._extract_text(self.query)
        clean_contexts = self._extract_text(self.contexts)
        clean_response = self._extract_text(self.response)

        # Берем учетные данные из переменных окружения
        env_api_key = os.environ.get("YANDEX_API_KEY", "")
        env_folder_id = os.environ.get("YANDEX_FOLDER_ID", "")

        if not env_api_key or not env_folder_id:
            return Data(value="Ошибка: Установите переменные окружения YANDEX_API_KEY и YANDEX_FOLDER_ID!")

        # URL эндпоинта берется из поля ввода
        endpoint = self.endpoint_url.strip() if self.endpoint_url else "https://llm.api.cloud.yandex.net/v1/chat/completions"
        
        headers = {
            "Authorization": f"Bearer {env_api_key}",
            "Content-Type": "application/json"
        }

        # Сборка финального URI модели
        final_model_uri = self.model.strip()
        if env_folder_id and not final_model_uri.startswith("gpt://"):
            model_path = final_model_uri.lstrip("/")
            final_model_uri = f"gpt://{env_folder_id}/{model_path}"

        # Строгий экспертный промпт
        prompt = (
            f"Ты строгий эксперт-судья по RAG-системам. Оцени предоставленный конвейер по двум метрикам:\n"
            f"1. Обоснованность (Faithfulness): Насколько Ответ подтверждается Контекстом (выставь оценку от 0 до 1 и кратко обоснуй).\n"
            f"2. Релевантность (Answer Relevance): Насколько качественно Ответ закрывает Исходный Вопрос (выставь оценку от 0 до 1 и кратко обоснуй).\n\n"
            f"Вопрос: {clean_query}\n\n"
            f"Контекст: {clean_contexts}\n\n"
            f"Ответ: {clean_response}"
        )

        payload = {
            "model": final_model_uri,
            "temperature": 0.1,
            "max_tokens": 2000,
            "messages": [
                {
                    "role": "system", 
                    "content": "Отвечай строго структурированно. Обязательно начни ответ с ключевых слов ровно в таком формате:\nОбоснованность: [оценка от 0 до 1]\nРелевантность: [оценка от 0 до 1]\nЗатем напиши краткое текстовое обоснование."
                },
                {
                    "role": "user", 
                    "content": prompt
                }
            ]
        }

        faithfulness_score = None
        relevance_score = None
        output_result = ""

        try:
            res = requests.post(endpoint, json=payload, headers=headers, timeout=60)
            
            if res.status_code != 200:
                raise Exception(f"Yandex OpenAI-API error {res.status_code}: {res.text}")
                
            res_json = res.json()
            
            if "choices" in res_json and isinstance(res_json["choices"], list) and len(res_json["choices"]) > 0:
                first_choice = res_json["choices"][0]
                if "message" in first_choice and "content" in first_choice["message"]:
                    output_result = first_choice["message"]["content"]
            
            if not output_result:
                output_result = json.dumps(res_json, ensure_ascii=False)
                
        except Exception as e:
            output_result = f"Error calling Yandex OpenAI-API: {str(e)}"

        # Поиск числовых оценок регулярными выражениями
        if output_result and not output_result.startswith("Error calling Yandex"):
            try:
                faith_match = re.search(r'(?:Обоснованность|Faithfulness)\s*[:\-]?\s*(\d+(?:[.,]\d+)?)', output_result, re.IGNORECASE)
                rel_match = re.search(r'(?:Релевантность|Relevance)\s*[:\-]?\s*(\d+(?:[.,]\d+)?)', output_result, re.IGNORECASE)
                
                if faith_match:
                    faithfulness_score = float(faith_match.group(1).replace(',', '.'))
                if rel_match:
                    relevance_score = float(rel_match.group(1).replace(',', '.'))
            except Exception:
                pass

        # Логирование в Phoenix
        if (faithfulness_score is not None or relevance_score is not None) and not output_result.startswith("Error calling Yandex"):
            try:
                import phoenix as px
                from phoenix.trace import Evaluation
                from openinference.instrumentation import get_current_span
                
                current_span = get_current_span()
                if current_span and current_span.get_context():
                    context = current_span.get_context()
                    trace_id_str = format(context.trace_id, '032x')
                    root_span_id_str = trace_id_str[-16:]
                    
                    px_client = px.Client(endpoint="http://phoenix:6006")
                    evaluations_list = []
                    
                    if faithfulness_score is not None:
                        evaluations_list.append(Evaluation(name="faithfulness", score=float(faithfulness_score), trace_id=trace_id_str, span_id=root_span_id_str, explanation=output_result))
                    if relevance_score is not None:
                        evaluations_list.append(Evaluation(name="answer_relevance", score=float(relevance_score), trace_id=trace_id_str, span_id=root_span_id_str, explanation=output_result))
                    
                    if evaluations_list:
                        px_client.log_evaluations(evaluations_list)
            except Exception:
                pass

        meta = {
            "faithfulness": str(faithfulness_score), 
            "relevance": str(relevance_score),
            "model_uri": final_model_uri,
            "endpoint_url": endpoint,
            "query_len": len(clean_query),
            "context_len": len(clean_contexts),
            "response_len": len(clean_response)
        }
        return Data(value=output_result, metadata=meta)
