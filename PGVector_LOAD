from langchain_community.vectorstores import PGVector
from lfx.base.vectorstores.model import LCVectorStoreComponent, check_cached_vector_store
from lfx.helpers.data import docs_to_data
from lfx.io import HandleInput, IntInput as LfxIntInput, SecretStrInput, StrInput as LfxStrInput
from lfx.schema.data import Data
from lfx.utils.connection_string_parser import transform_connection_string
import json

class PGVectorStoreComponent(LCVectorStoreComponent):
    display_name = "PGVector_Load"
    description = "PGVector Vector Store with search capabilities"
    name = "pgvector"
    icon = "cpu"

    inputs = [
        SecretStrInput(name="pg_server_url", display_name="PostgreSQL Server Connection String", required=True),
        LfxStrInput(name="collection_name", display_name="Collection", required=True),
        *LCVectorStoreComponent.inputs,
        HandleInput(name="embedding", display_name="Embedding", input_types=["Embeddings"], required=True),
        LfxIntInput(name="number_of_results", display_name="Number of Results", value=4, advanced=True),
        LfxStrInput(name="search_query", display_name="Search Query", advanced=True),
    ]

    @check_cached_vector_store
    def build_vector_store(self) -> PGVector:
        self.ingest_data = self._prepare_ingest_data()
        documents = []
        
        for _input in self.ingest_data or []:
            doc = _input.to_lc_document() if isinstance(_input, Data) else _input
            
            if hasattr(doc, "metadata") and doc.metadata:
                # 1. Если метаданные пришли строкой — парсим в dict
                if isinstance(doc.metadata, str):
                    try:
                        doc.metadata = json.loads(doc.metadata)
                    except Exception:
                        doc.metadata = {}
                
                # 2. Если это объект с методом конвертации (например, pydantic / Properties)
                elif hasattr(doc.metadata, "dict") and callable(getattr(doc.metadata, "dict")):
                    doc.metadata = doc.metadata.dict()
                elif hasattr(doc.metadata, "model_dump") and callable(getattr(doc.metadata, "model_dump")):
                    doc.metadata = doc.metadata.model_dump()
                
                # 3. Гарантируем, что это dict, и чистим его внутренности от не-JSON объектов
                if isinstance(doc.metadata, dict):
                    clean_metadata = {}
                    for k, v in doc.metadata.items():
                        try:
                            # Проверяем, сериализуемо ли конкретное значение
                            json.dumps(v)
                            clean_metadata[k] = v
                        except TypeError:
                            # Если значение — объект Properties (или другой сложный класс)
                            if hasattr(v, "dict") and callable(getattr(v, "dict")):
                                clean_metadata[k] = v.dict()
                            elif hasattr(v, "model_dump") and callable(getattr(v, "model_dump")):
                                clean_metadata[k] = v.model_dump()
                            else:
                                # В крайнем случае приводим к строке, чтобы избежать падения базы
                                clean_metadata[k] = str(v)
                    doc.metadata = clean_metadata
                else:
                    doc.metadata = {}
                    
            documents.append(doc)


        conn_str = transform_connection_string(self.pg_server_url)

        if documents:
            return PGVector.from_documents(
                embedding=self.embedding, documents=documents,
                collection_name=self.collection_name, connection_string=conn_str
            )
        return PGVector.from_existing_index(
            embedding=self.embedding, collection_name=self.collection_name, connection_string=conn_str
        )
        

    def search_documents(self) -> list[Data]:
        vector_store = self.build_vector_store()
        if self.search_query and isinstance(self.search_query, str) and self.search_query.strip():
            docs = vector_store.similarity_search(query=self.search_query, k=self.number_of_results)
            data = docs_to_data(docs)
            self.status = data
            return data
        return []
