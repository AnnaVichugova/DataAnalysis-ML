from lfx.base.embeddings.model import LCEmbeddingsModel
from lfx.field_typing import Embeddings
from lfx.io import (
    SecretStrInput,
    StrInput,
    IntInput,
    FloatInput,
)
from langchain_core.embeddings import Embeddings
from typing import List
import requests
import json
import time


class YandexCloudEmbeddings(Embeddings):
    def __init__(
        self,
        api_key: str,
        folder_id: str,
        model: str,
        base_url: str,
        dimensions: int = None,
        delay: float = 0.2
    ):
        self.api_key = api_key
        self.folder_id = folder_id
        self.model = model
        self.base_url = base_url
        self.dimensions = dimensions
        self.delay = delay
        
        if self.base_url.endswith('/'):
            self.base_url = self.base_url[:-1]
        self.endpoint = self.base_url
        
    def embed_query(self, text: str) -> List[float]:
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "x-folder-id": self.folder_id,
            "Content-Type": "application/json"
        }
        
        payload = {
            "modelUri": self.model,
            "text": text
        }
        
        if self.dimensions:
            payload["dimensions"] = self.dimensions
        
        print(f"   Sending to Yandex: {self.endpoint}")
        print(f"   Headers: x-folder-id={self.folder_id}")
        print(f"   Payload: {json.dumps(payload, ensure_ascii=False)}")
        
        try:
            response = requests.post(
                self.endpoint,
                headers=headers,
                json=payload,
                timeout=60
            )
            
            print(f"   Response status: {response.status_code}")
            
            if response.status_code == 429:
                print(f"   Rate limit hit, waiting 1 second...")
                time.sleep(1)
                return self.embed_query(text)
            
            if response.status_code != 200:
                print(f"   Error response: {response.text}")
                raise Exception(f"Yandex API error {response.status_code}: {response.text}")
            
            data = response.json()
            
            if "embedding" in data:
                return data["embedding"]
            else:
                raise Exception(f"Unexpected response format: {data}")
                
        except requests.exceptions.RequestException as e:
            print(f"   Request error: {e}")
            raise
    
    def embed_documents(self, texts: List[str]) -> List[List[float]]:
        results = []
        total = len(texts)
        for idx, text in enumerate(texts):
            print(f"   Processing document {idx+1}/{total}...")
            results.append(self.embed_query(text))
            if idx < total - 1:
                time.sleep(self.delay)
        return results


